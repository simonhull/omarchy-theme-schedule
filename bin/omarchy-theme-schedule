#!/bin/bash

# omarchy:summary=Switch themes on a daily schedule, such as a light theme at sunrise and a dark one at sunset
# omarchy:args=[status|apply [--force]|on|off|list|add <at> <theme>|set <n> <at> <theme>|remove <n>|setup|teardown|update|--version]
# omarchy:examples=omarchy theme schedule add sunset "Tokyo Night"|omarchy theme schedule add 07:30 flexoki-light|omarchy theme schedule status

source "${OMARCHY_THEME_SCHEDULE_LIB:-/usr/share/omarchy-theme-schedule}/schedule.sh" || exit 1

TS_VERSION=0.1.1
TS_MENU_FILE="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
TS_MENU_BLOCK="$TS_LIB/menu.jsonc"
TS_ICON="󰸌"

# English for every string shown. omarchy-i18n prints a key back when its
# catalog has no entry, which holds for all of these until they are added to
# Omarchy's own catalog; then this table can go.
declare -A TS_ENGLISH=(
  [themeSchedule.statusOn]="Theme schedule: on"
  [themeSchedule.statusOff]="Theme schedule: off"
  [themeSchedule.location]="Location: %1"
  [themeSchedule.noLocation]="No location set, so sunrise is %1 and sunset is %2. Set one in the weather panel."
  [themeSchedule.polar]="The sun does not rise or set here today, so sunrise is %1 and sunset is %2."
  [themeSchedule.noSlots]="No slots. Add one with: omarchy theme schedule add <at> <theme>"
  [themeSchedule.active]="active"
  [themeSchedule.next]="Next switch: %1 at %2"
  [themeSchedule.invalidAt]="Not a schedule time: %1 (use HH:MM, sunrise or sunset, with an optional offset like sunset-30m)"
  [themeSchedule.unknownTheme]="Theme '%1' is not installed"
  [themeSchedule.skippedSlot]="Slot %1 is skipped: %2"
  [themeSchedule.skipMalformed]="it needs an at and a theme"
  [themeSchedule.skipBadTime]="invalid time %1"
  [themeSchedule.noSuchSlot]="No slot %1"
  [themeSchedule.themeMissing]="Scheduled theme is not installed"
  [themeSchedule.switchFailed]="Could not switch to %1"
  [themeSchedule.themeMissingBody]="Skipped %1. The schedule carries on at the next slot."
  [themeSchedule.timerFailed]="Could not start the schedule timer. See: systemctl --user status omarchy-theme-schedule.timer"
  [themeSchedule.enabled]="Theme schedule on"
  [themeSchedule.disabled]="Theme schedule off"
  [themeSchedule.setupDone]="Added Appearance › Theme Schedule to the Omarchy menu"
  [themeSchedule.teardownDone]="Removed Theme Schedule from the Omarchy menu"
  [themeSchedule.menuFileUnreadable]="Cannot add the menu rows: %1 has no line holding just '{'"
  [themeSchedule.menuBlockDamaged]="%1 has an unfinished theme-schedule block; fix or remove it by hand"
  [themeSchedule.menuItemsWrapper]="%1 wraps its rows in \"items\"; add the theme schedule rows inside it by hand"
  [themeSchedule.menuFailed]="Theme schedule not changed"
  [themeSchedule.updateFetchFailed]="Could not download the installer"
  [themeSchedule.updateTitle]="Theme Schedule %1 is available"
  [themeSchedule.updateBody]="Update it from the Omarchy menu (Update › Theme Schedule) or run: omarchy theme schedule update"
  [themeSchedule.menuSlots]="Theme schedule"
  [themeSchedule.menuSlotAction]="Slot"
  [themeSchedule.menuChangeTime]="Change time"
  [themeSchedule.menuChangeTheme]="Change theme"
  [themeSchedule.menuRemove]="Remove"
  [themeSchedule.menuPickTime]="When"
  [themeSchedule.menuSunrise]="Sunrise"
  [themeSchedule.menuSunset]="Sunset"
  [themeSchedule.menuClock]="Specific time"
  [themeSchedule.menuClockPrompt]="Time (HH:MM)"
  [themeSchedule.menuOffset]="How close to it"
  [themeSchedule.offsetExact]="Exactly"
  [themeSchedule.offsetHourBefore]="1 hour before"
  [themeSchedule.offsetHalfBefore]="30 minutes before"
  [themeSchedule.offsetHalfAfter]="30 minutes after"
  [themeSchedule.offsetHourAfter]="1 hour after"
  [themeSchedule.menuPickTheme]="Theme"
)

# A user-facing string in the current language, with %1-style arguments.
t() {
  local key=$1 text out="" n
  shift

  text=$(omarchy-i18n "$key" "$@" 2>/dev/null)
  if [[ -z $text || $text == "$key" ]]; then
    text=${TS_ENGLISH[$key]:-$key}
    # One pass over the template, so an argument that itself contains %1 is
    # never substituted again.
    while [[ $text =~ ^([^%]*)%([0-9]+)(.*)$ ]]; do
      out+=${BASH_REMATCH[1]}
      n=${BASH_REMATCH[2]}
      text=${BASH_REMATCH[3]}
      if ((n >= 1 && n <= $#)); then
        out+=${!n}
      else
        out+="%$n"
      fi
    done
    text=$out$text
  fi

  printf '%s\n' "$text"
}

usage() {
  cat <<'EOF'
Usage: omarchy-theme-schedule <command>

  status                  Show the schedule and what it does today
  apply [--force]         Switch to the active slot's theme if the slot changed
  on | off                Turn the schedule on or off
  list                    List the slots
  add <at> <theme>        Add a slot
  set <n> <at> <theme>    Replace slot n
  remove <n>              Remove slot n
  setup | teardown        Add or remove Theme Schedule in the Omarchy menu
  update                  Install the latest release
  --version               Print the version

<at> is HH:MM, sunrise or sunset, with an optional offset: sunset-30m, sunrise+1h.
EOF
}

# Rewrites the schedule through a jq filter (and its arguments), atomically.
ts_update_config() {
  local current tmp

  current=$(cat "$TS_CONFIG" 2>/dev/null)
  # A missing, empty or blank file is an empty schedule, not a jq error.
  [[ $current =~ [^[:space:]] ]] || current='{"slots": []}'
  mkdir -p "${TS_CONFIG%/*}"
  tmp=$(mktemp "$TS_CONFIG.XXXXXX") || return 1

  # Never replace the schedule with nothing.
  if jq "$@" <<<"$current" >"$tmp" && [[ -s $tmp ]]; then
    # mktemp makes the file private; keep the mode the config had.
    chmod --reference="$TS_CONFIG" "$tmp" 2>/dev/null || chmod 644 "$tmp"
    mv "$tmp" "$TS_CONFIG"
  else
    rm -f "$tmp"
    return 1
  fi
}

slot_count() {
  jq '.slots // [] | length' "$TS_CONFIG" 2>/dev/null || echo 0
}

# One field of slot n (1-based), for the menu helpers.
slot_field() {
  jq -r --argjson index "$(($1 - 1))" --arg field "$2" '.slots[$index][$field]' "$TS_CONFIG"
}

check_slot_number() {
  if [[ $1 =~ ^[1-9][0-9]*$ ]] && (($1 <= $(slot_count))); then
    return 0
  fi
  t themeSchedule.noSuchSlot "$1" >&2
  return 1
}

check_at() {
  ts_parse_at "$1" >/dev/null && return 0
  t themeSchedule.invalidAt "$1" >&2
  return 1
}

# Prints the installed theme a name refers to, or explains that there is none.
resolve_theme() {
  local theme

  theme=$(ts_normalize_theme "$1")
  if ! ts_theme_installed "$theme"; then
    t themeSchedule.unknownTheme "$1" >&2
    return 1
  fi
  echo "$theme"
}

# An edited schedule takes effect at once, rather than at the next slot.
apply_if_on() {
  if omarchy-toggle-enabled theme-schedule; then
    cmd_apply --force
  fi
  return 0
}

cmd_list() {
  local slots number kind at theme

  # Every entry keeps its number; a malformed one, or one whose time is not a
  # schedule time, is shown as invalid, so the numbers still match what set
  # and remove take.
  while IFS=$'\t' read -r number kind at theme; do
    case $kind in
      slot)
        if ts_parse_at "$at" >/dev/null; then
          slots+="$number  $at  $theme"$'\n'
        else
          slots+="$number  (invalid time: $at)"$'\n'
        fi
        ;;
      *) slots+="$number  (invalid: $at)"$'\n' ;;
    esac
  done < <(jq -r '.slots // [] | if type == "array" then to_entries[] else empty end | .value as $v
    | if ($v | type) == "object" and ($v.at | type) == "string" and ($v.theme | type) == "string"
      then [.key + 1, "slot", $v.at, $v.theme] else [.key + 1, "bad", ($v | tojson)] end | @tsv' "$TS_CONFIG" 2>/dev/null)
  if [[ -n $slots ]]; then
    printf '%s' "$slots"
  else
    t themeSchedule.noSlots
  fi
}

cmd_add() {
  local at=${1:-} theme

  (($# == 2)) || { usage >&2; return 1; }
  check_at "$at" || return 1
  theme=$(resolve_theme "$2") || return 1

  ts_update_config --arg at "$at" --arg theme "$theme" '.slots = ((.slots // []) + [{at: $at, theme: $theme}])' || return 1
  apply_if_on
}

cmd_set() {
  local number=${1:-} at=${2:-} theme

  (($# == 3)) || { usage >&2; return 1; }
  check_slot_number "$number" || return 1
  check_at "$at" || return 1
  theme=$(resolve_theme "$3") || return 1

  ts_update_config --argjson index "$((number - 1))" --arg at "$at" --arg theme "$theme" \
    '.slots[$index] = {at: $at, theme: $theme}' || return 1
  apply_if_on
}

cmd_remove() {
  (($# == 1)) || { usage >&2; return 1; }
  check_slot_number "$1" || return 1

  ts_update_config --argjson index "$(($1 - 1))" 'del(.slots[$index])' || return 1
  apply_if_on
}

cmd_apply() {
  local force=false active key theme status=0 tmp

  [[ ${1:-} == --force ]] && force=true
  omarchy-toggle-enabled theme-schedule || return 0

  # Runs can overlap (the timer, plus on or the menu). Whoever holds the lock
  # decides and records; the others then see the record and do nothing, so a
  # slot is never switched twice. Everything below reads state under the lock.
  exec 9>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-theme-schedule.lock"
  # A hung switch must not stall the schedule for good, so the wait is bounded.
  # Giving up is safe: another run holds the lock; it will apply.
  flock -w "${OMARCHY_THEME_SCHEDULE_LOCK_WAIT:-60}" 9 || return 0

  active=$(ts_active "$(ts_now)")
  [[ -n $active ]] || return 0
  key=$(ts_occurrence_key "$active")
  theme=$(cut -f4 <<<"$active")

  # A slot already applied stays applied whatever the theme is now: that is
  # what lets a theme picked by hand hold until the next slot.
  if [[ $force == false && $(cat "$TS_APPLIED" 2>/dev/null) == "$key" ]]; then
    return 0
  fi

  if ! ts_theme_installed "$theme"; then
    omarchy-notification-send -g "$TS_ICON" -u normal "$(t themeSchedule.themeMissing)" \
      "$(t themeSchedule.themeMissingBody "$theme")" >/dev/null
  elif [[ $(ts_current_theme) != "$theme" ]]; then
    # Defence in depth: the switch never needs the schedule lock.
    if ! omarchy-theme-set "$theme" 9>&-; then
      # Recorded anyway: retrying every minute would only repeat the failure.
      omarchy-notification-send -g "$TS_ICON" -u normal "$(t themeSchedule.switchFailed "$theme")" >/dev/null
      status=1
    fi
  fi

  mkdir -p "${TS_APPLIED%/*}"
  tmp=$(mktemp "$TS_APPLIED.XXXXXX") || return 1
  printf '%s\n' "$key" >"$tmp" && mv "$tmp" "$TS_APPLIED" || { rm -f "$tmp"; return 1; }
  return "$status"
}

# A first schedule from the current theme: it keeps its place by day or by
# night, whichever its mode suits, and a stock theme takes the other.
seed_config() {
  local current day=flexoki-light night=tokyo-night

  current=$(ts_current_theme)
  if [[ -n $current ]]; then
    if [[ $(omarchy-theme-color mode 2>/dev/null) == light ]]; then
      day=$current
    else
      night=$current
    fi
  fi

  ts_update_config --arg day "$day" --arg night "$night" \
    '.slots = [{at: "sunrise", theme: $day}, {at: "sunset", theme: $night}]'
}

cmd_on() {
  local status=0

  [[ -f $TS_CONFIG ]] || seed_config || return 1

  omarchy-toggle theme-schedule on
  if ! systemctl --user enable --now omarchy-theme-schedule.timer >/dev/null 2>&1; then
    # Toggle and timer always change together: no timer, no toggle.
    omarchy-toggle theme-schedule off
    t themeSchedule.timerFailed >&2
    return 1
  fi

  # A failed switch has already been reported by apply.
  cmd_apply --force || status=$?
  omarchy-notification-send -g "$TS_ICON" "$(t themeSchedule.enabled)" >/dev/null || true
  return "$status"
}

cmd_off() {
  omarchy-toggle theme-schedule off
  systemctl --user disable --now omarchy-theme-schedule.timer >/dev/null 2>&1
  omarchy-notification-send -g "$TS_ICON" "$(t themeSchedule.disabled)" >/dev/null || true
  return 0
}

cmd_status() {
  local now today active active_number next epoch day at theme number marker

  now=$(ts_now)
  today=$(date -d "@$now" +%F)

  if omarchy-toggle-enabled theme-schedule; then
    t themeSchedule.statusOn
  else
    t themeSchedule.statusOff
  fi

  case $(ts_sun_fallback "$today") in
    no-location) t themeSchedule.noLocation "$TS_FALLBACK_SUNRISE" "$TS_FALLBACK_SUNSET" ;;
    polar) t themeSchedule.polar "$TS_FALLBACK_SUNRISE" "$TS_FALLBACK_SUNSET" ;;
    *) t themeSchedule.location "$(ts_location_name)" ;;
  esac

  while IFS=$'\t' read -r number reason at; do
    case $reason in
      bad-time) t themeSchedule.skippedSlot "$number" "$(t themeSchedule.skipBadTime "$at")" ;;
      *) t themeSchedule.skippedSlot "$number" "$(t themeSchedule.skipMalformed)" ;;
    esac
  done < <(ts_skipped_slots)

  active=$(ts_active "$now")
  if [[ -z $active ]]; then
    t themeSchedule.noSlots
    return 0
  fi
  active_number=$(cut -f5 <<<"$active")

  while IFS=$'\t' read -r epoch day at theme number; do
    marker=""
    [[ $number == "$active_number" ]] && marker="  ($(t themeSchedule.active))"
    printf '  %s  %-12s %s  %s%s\n' "$number" "$at" "$(date -d "@$epoch" +%H:%M)" "$theme" "$marker"
  done < <(ts_occurrences "$now" | awk -F '\t' -v today="$today" '$2 == today')

  next=$(ts_next "$now")
  if [[ -n $next ]]; then
    IFS=$'\t' read -r epoch day at theme number <<<"$next"
    t themeSchedule.next "$theme" "$(date -d "@$epoch" '+%a %H:%M')"
  fi
}

# Rewrites the menu file through a command reading it on stdin, keeping its
# permissions. The shell watches the file, so the menu updates at once. A
# symlinked file (dotfiles managers do this) is rewritten where it points, so
# the link survives.
rewrite_menu_file() {
  local file tmp

  file=$(readlink -m -- "$TS_MENU_FILE") || return 1
  tmp=$(mktemp "$file.XXXXXX") || return 1
  if "$@" <"$file" >"$tmp"; then
    chmod --reference="$file" "$tmp"
    mv "$tmp" "$file"
  else
    rm -f "$tmp"
    return 1
  fi
}

TS_MENU_OPEN='^[[:space:]]*[{][[:space:]]*(//.*)?$'
TS_MENU_BEGIN='^[[:space:]]*// theme-schedule:begin'
TS_MENU_END='^[[:space:]]*// theme-schedule:end'

# One pass that drops the marked block (if any) and, for setup, puts a fresh one
# right after the opening brace. Its rows all end in a comma, which is valid
# there whatever follows, since the shell drops a trailing comma. Only called
# on a file menu_block_state found ok or absent.
menu_block_edit() {
  awk -v mode="$1" -v block="$TS_MENU_BLOCK" -v open="$TS_MENU_OPEN" \
    -v begin="$TS_MENU_BEGIN" -v end="$TS_MENU_END" '
    $0 ~ begin { skipping = 1 }
    skipping { if ($0 ~ end) skipping = 0; next }
    { print }
    mode == "setup" && !done && $0 ~ open {
      while ((getline line < block) > 0) print line
      done = 1
    }
  '
}

# ok: exactly one begin line, later followed by exactly one end line.
# absent: neither marker. damaged: anything else, which no edit may touch,
# since a range delete from a lone begin marker would eat the rest of the file.
menu_block_state() {
  awk -v begin="$TS_MENU_BEGIN" -v end="$TS_MENU_END" '
    $0 ~ begin { b++; if (!e) first_begin = NR }
    $0 ~ end { e++; if (b && !ended) ended = NR }
    END {
      if (b == 0 && e == 0) print "absent"
      else if (b == 1 && e == 1 && first_begin < ended) print "ok"
      else print "damaged"
    }
  ' "$1"
}

# True when the file is an object whose rows live under "items", which the menu
# then reads instead of the top level.
menu_file_wraps_items() {
  grep -vE '^[[:space:]]*//' "$1" | perl -0pe 's/,(\s*[}\]])/$1/g' \
    | jq -e 'type == "object" and (.items | type) == "object"' >/dev/null 2>&1
}

cmd_setup() {
  local file

  file=$(readlink -m -- "$TS_MENU_FILE") || return 1
  mkdir -p "${file%/*}"
  # A missing, empty or blank file is an empty menu.
  if [[ ! -f $file ]] || ! grep -q '[^[:space:]]' "$file"; then
    printf '{\n}\n' >"$file"
  fi

  if ! grep -qE "$TS_MENU_OPEN" "$file"; then
    t themeSchedule.menuFileUnreadable "$TS_MENU_FILE" >&2
    return 1
  fi
  if [[ $(menu_block_state "$file") == damaged ]]; then
    t themeSchedule.menuBlockDamaged "$TS_MENU_FILE" >&2
    return 1
  fi
  if menu_file_wraps_items "$file"; then
    t themeSchedule.menuItemsWrapper "$TS_MENU_FILE" >&2
    return 1
  fi

  # An existing block is replaced in the same rewrite: setup is repeatable, and
  # old rows update.
  rewrite_menu_file menu_block_edit setup || return 1
  t themeSchedule.setupDone
}

cmd_teardown() {
  local file state

  file=$(readlink -m -- "$TS_MENU_FILE") || return 1
  [[ -f $file ]] || return 0
  state=$(menu_block_state "$file")
  case $state in
    absent) return 0 ;;
    damaged)
      t themeSchedule.menuBlockDamaged "$TS_MENU_FILE" >&2
      return 1
      ;;
  esac
  rewrite_menu_file menu_block_edit teardown || return 1
  t themeSchedule.teardownDone
}

# check-update [--notify|--cached] is a hidden helper (kept out of the usage
# text) for the post-update hook and the menu's `when` conditions. It prints:
#   latest             this version is the newest release
#   available <ver>   a newer release exists
#   (nothing)          the remote could not be read, or there is no cache yet
# and always exits 0, so a hook running it can never break `omarchy update`.
# Releases are git tags vX.Y.Z; `git ls-remote` reads them without the GitHub
# API's rate limits. The newest tag is cached in
# ${XDG_CACHE_HOME:-~/.cache}/omarchy-theme-schedule/latest.
#   --cached   only read the cache, with no network call (cheap enough for a
#              menu `when`)
#   --notify   when a version newer than the last one notified about exists,
#              send one notification and record it in the cache dir ("notified")
ts_cache_dir() {
  echo "${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-theme-schedule"
}

# Prints the newest vX.Y.Z tag at the remote, without the v; nothing when the
# remote is unreachable or has no such tag.
ts_latest_release() {
  local remote=${OMARCHY_THEME_SCHEDULE_REMOTE:-https://github.com/simonhull/omarchy-theme-schedule}

  GIT_TERMINAL_PROMPT=0 timeout "${OMARCHY_THEME_SCHEDULE_CHECK_TIMEOUT:-10}" \
    git ls-remote --tags --refs "$remote" 2>/dev/null \
    | sed -nE 's|^[0-9a-f]+[[:space:]]+refs/tags/v([0-9]+\.[0-9]+\.[0-9]+)$|\1|p' \
    | sort -V | tail -n 1
}

# Prints the verdict for a latest version, or nothing for a malformed one.
ts_update_verdict() {
  local latest=$1 newest

  [[ $latest =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 0
  newest=$(printf '%s\n%s\n' "$TS_VERSION" "$latest" | sort -V | tail -n 1)
  if [[ $latest != "$TS_VERSION" && $newest == "$latest" ]]; then
    echo "available $latest"
  else
    echo latest
  fi
}

cmd_check_update() {
  local mode=${1:-} dir latest tmp verdict

  dir=$(ts_cache_dir)

  if [[ $mode == --cached ]]; then
    ts_update_verdict "$(cat "$dir/latest" 2>/dev/null)"
    return 0
  fi

  latest=$(ts_latest_release)
  verdict=$(ts_update_verdict "$latest")
  [[ -n $verdict ]] || return 0

  if mkdir -p "$dir" && tmp=$(mktemp "$dir/latest.XXXXXX"); then
    printf '%s\n' "$latest" >"$tmp" && mv "$tmp" "$dir/latest" || rm -f "$tmp"
  fi
  echo "$verdict"

  if [[ $mode == --notify && $verdict == available* && $(cat "$dir/notified" 2>/dev/null) != "$latest" ]]; then
    omarchy-notification-send -g "$TS_ICON" "$(t themeSchedule.updateTitle "$latest")" \
      "$(t themeSchedule.updateBody)" >/dev/null || true
    printf '%s\n' "$latest" >"$dir/notified"
  fi
  return 0
}

# Upgrades by running the installer. It asks sudo for a password, so it needs a
# terminal: from the menu (no terminal on stdin) it reopens itself in a floating
# one. OMARCHY_THEME_SCHEDULE_TTY=1/0 stands in for the terminal test.
cmd_update() {
  local url=${OMARCHY_THEME_SCHEDULE_INSTALLER_URL:-https://raw.githubusercontent.com/simonhull/omarchy-theme-schedule/main/install.sh}
  local tty=${OMARCHY_THEME_SCHEDULE_TTY:-}
  local installer

  if [[ -z $tty ]]; then
    if [[ -t 0 ]]; then tty=1; else tty=0; fi
  fi

  if [[ $tty != 1 ]]; then
    omarchy-launch-floating-terminal-with-presentation omarchy-theme-schedule update
    return
  fi

  # Fetched whole before anything runs, so a failed download runs nothing.
  if ! installer=$(curl -fsSL "$url") || [[ -z $installer ]]; then
    t themeSchedule.updateFetchFailed >&2
    return 1
  fi
  bash <<<"$installer"
}

pretty_theme() {
  sed -E 's/-/ /g; s/\b(.)/\u\1/g' <<<"$1"
}

pretty_at() {
  sed -E 's/^s/S/' <<<"$1"
}

# Runs a command for the menu, where nobody reads stderr: an error becomes a
# notification instead.
menu_run() {
  local error

  error=$("$@" 2>&1 >/dev/null) && return 0
  [[ -n $error ]] || error=$(t themeSchedule.menuFailed)
  omarchy-notification-send -g "$TS_ICON" -u normal "$(t themeSchedule.menuFailed)" "$error" >/dev/null
  return 1
}

# Asks when a slot starts and prints its at; fails when dismissed. Its stdout is
# the result, so everything in here except the final echo must go to stderr or
# /dev/null.
menu_pick_at() {
  local sunrise sunset clock when time label i
  local -a offsets=("" -1h -30m +30m +1h)
  local -a offset_labels=(
    "$(t themeSchedule.offsetExact)"
    "$(t themeSchedule.offsetHourBefore)"
    "$(t themeSchedule.offsetHalfBefore)"
    "$(t themeSchedule.offsetHalfAfter)"
    "$(t themeSchedule.offsetHourAfter)"
  )

  sunrise=$(t themeSchedule.menuSunrise)
  sunset=$(t themeSchedule.menuSunset)
  clock=$(t themeSchedule.menuClock)

  when=$(omarchy-menu-select "$(t themeSchedule.menuPickTime)" "$sunrise" "$sunset" "$clock") || return 1
  case $when in
    "$sunrise") when=sunrise ;;
    "$sunset") when=sunset ;;
    "$clock")
      time=$(omarchy-menu-input "$(t themeSchedule.menuClockPrompt)") || return 1
      # An empty Enter is not an error to report; the real input exits 0 on it.
      time=${time#"${time%%[![:space:]]*}"}
      time=${time%"${time##*[![:space:]]}"}
      [[ -n $time ]] || return 1
      if ! ts_parse_at "$time" >/dev/null; then
        omarchy-notification-send -g "$TS_ICON" -u normal "$(t themeSchedule.menuFailed)" \
          "$(t themeSchedule.invalidAt "$time")" >/dev/null
        return 1
      fi
      echo "$time"
      return 0
      ;;
    *) return 1 ;;
  esac

  label=$(omarchy-menu-select "$(t themeSchedule.menuOffset)" "${offset_labels[@]}") || return 1
  for i in "${!offset_labels[@]}"; do
    if [[ ${offset_labels[$i]} == "$label" ]]; then
      echo "$when${offsets[$i]}"
      return 0
    fi
  done
  return 1
}

# Asks for a theme and prints its name; fails when dismissed.
menu_pick_theme() {
  local name

  name=$(omarchy-theme-list | omarchy-menu-select "$(t themeSchedule.menuPickTheme)" -- --maxheight 520) || return 1
  ts_normalize_theme "$name"
}

menu_add() {
  local at theme

  at=$(menu_pick_at) || return 0
  theme=$(menu_pick_theme) || return 0
  menu_run cmd_add "$at" "$theme"
}

# Today's slots in time order. A row starts with its slot number, which is
# all that is read back from the choice.
menu_slots() {
  local now today epoch day at theme number choice action change_time change_theme remove
  local -a rows=()

  now=$(ts_now)
  today=$(date -d "@$now" +%F)
  while IFS=$'\t' read -r epoch day at theme number; do
    # A clock time is its own time; only a sun-relative slot needs the resolved one.
    if [[ $at =~ ^[0-9]{2}:[0-9]{2}$ ]]; then
      rows+=("$number. $at → $(pretty_theme "$theme")")
    else
      rows+=("$number. $(pretty_at "$at") ($(date -d "@$epoch" +%H:%M)) → $(pretty_theme "$theme")")
    fi
  done < <(ts_occurrences "$now" | awk -F '\t' -v today="$today" '$2 == today')

  if ((${#rows[@]} == 0)); then
    menu_add
    return
  fi

  choice=$(omarchy-menu-select "$(t themeSchedule.menuSlots)" "${rows[@]}") || return 0
  number=${choice%%.*}
  [[ $number =~ ^[0-9]+$ ]] || return 0

  change_time=$(t themeSchedule.menuChangeTime)
  change_theme=$(t themeSchedule.menuChangeTheme)
  remove=$(t themeSchedule.menuRemove)
  action=$(omarchy-menu-select "$(t themeSchedule.menuSlotAction)" "$change_time" "$change_theme" "$remove") || return 0

  case $action in
    "$change_time")
      at=$(menu_pick_at) || return 0
      menu_run cmd_set "$number" "$at" "$(slot_field "$number" theme)"
      ;;
    "$change_theme")
      theme=$(menu_pick_theme) || return 0
      menu_run cmd_set "$number" "$(slot_field "$number" at)" "$theme"
      ;;
    "$remove")
      menu_run cmd_remove "$number"
      ;;
  esac
}

cmd_menu() {
  case ${1:-} in
    slots) menu_slots ;;
    add) menu_add ;;
    *)
      usage >&2
      return 1
      ;;
  esac
}

main() {
  case ${1:-status} in
    status) cmd_status ;;
    apply) cmd_apply "${@:2}" ;;
    on) cmd_on ;;
    off) cmd_off ;;
    list) cmd_list ;;
    add) cmd_add "${@:2}" ;;
    set) cmd_set "${@:2}" ;;
    remove) cmd_remove "${@:2}" ;;
    menu) cmd_menu "${@:2}" ;;
    setup) cmd_setup ;;
    teardown) cmd_teardown ;;
    update) cmd_update ;;
    check-update) cmd_check_update "${@:2}" ;;
    --version | version) echo "omarchy-theme-schedule $TS_VERSION" ;;
    -h | --help | help) usage ;;
    *)
      usage >&2
      return 1
      ;;
  esac
}

main "$@"
