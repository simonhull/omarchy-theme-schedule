# Every minute, because each run works the active slot out afresh: suspend,
# DST, a new timezone or an edited schedule need nothing special. A run whose
# slot has not changed still works out today's occurrences and compares them
# with the last applied one, then exits.
[Unit]
Description=Check the Omarchy theme schedule every minute
PartOf=graphical-session.target
After=graphical-session.target

[Timer]
OnCalendar=minutely
AccuracySec=10s

[Install]
WantedBy=graphical-session.target
